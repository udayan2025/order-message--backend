{
  "name": "messageapi-server",
  "version": "1.0.0",
  "description": "MessageAPI Backend - Enterprise WhatsApp Gateway, Multi-Session Baileys Manager, and LangChain pgvector RAG ERP Engine",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "build:mcp": "tsc -p tsconfig.mcp.json",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "mcp": "tsx src/mcp/server.ts"
  },
  "keywords": [
    "whatsapp",
    "baileys",
    "langchain",
    "pgvector",
    "rag",
    "express",
    "postgresql",
    "prisma"
  ],
  "author": "MessageAPI Team",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "@langchain/core": "^0.3.37",
    "@langchain/google-genai": "^0.1.8",
    "@langchain/openai": "^0.4.3",
    "@modelcontextprotocol/sdk": "^1.6.1",
    "@prisma/client": "^5.22.0",
    "@whiskeysockets/baileys": "^6.7.12",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "dotenv-expand": "^12.0.1",
    "express": "^4.21.2",
    "mammoth": "^1.13.0",
    "openai": "^4.80.0",
    "pg": "^8.13.1",
    "pgvector": "^0.2.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.5",
    "prisma": "^5.22.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
